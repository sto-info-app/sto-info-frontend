{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    // Use Node-style modules/resolution compatible with Jest while still
    // understanding modern package exports (Angular publishes via exports).
    "module": "commonjs",
    "moduleResolution": "nodenext",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
