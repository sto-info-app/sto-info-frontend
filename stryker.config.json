{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.cjs",
    "enableFindRelatedTests": false
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.module.ts",
    "!src/environments/**/*.ts",
    "!src/main.ts",
    "!src/test.ts",
    "!src/**/*.model.ts",
    "!src/**/*.models.ts",
    "!src/**/*.interface.ts",
    "!src/**/*.interfaces.ts",
    "!src/**/*.enum.ts",
    "!src/**/*.constant.ts",
    "!src/**/*.constants.ts",
    "!src/test-setup.ts",
    "!src/app/static-pages/**",
    "!src/app/shared/components/lcars-*/**",
    "!src/app/template/footer/**"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 1.5,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "ignorePatterns": ["node_modules", "dist", "reports", "coverage"]
}
