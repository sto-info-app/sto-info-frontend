{
  "name": "sto-info-frontend",
  "version": "1.0.135",
  "description": "Star Trek Online Information App",
  "author": "Steve Roberts",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steverobertsuk/sto-info-frontend.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-env": "node src/environments/inject-env-vars.js",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "build:render": "npm run generate-env && npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint \"src/**/*.{ts,js,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js,html}\" --fix",
    "lint:lighthouse": "cross-env ENV_NAME=lighthouse-audit npm run build:render && lhci autorun",
    "lighthouse": "cross-env API_URL=${API_URL:-https://dev-api.startrekonline.info} npm run build:prod && lhci collect && lhci upload --target=filesystem --outputDir=reports/lighthouse && npm run summary:ci",
    "summary:ci": "node scripts/generate-ci-summary.mjs",
    "test": "jest --config jest.config.cjs --testPathIgnorePatterns='.fuzz.spec.ts'",
    "test:fuzz": "cross-env FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-50} jest --config jest.config.cjs --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:fuzz:full": "cross-env FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-1000} jest --config jest.config.cjs --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --runInBand --coverage --coverageDirectory=reports/coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=text --testPathIgnorePatterns='.fuzz.spec.ts'",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly",
    "test:mutation:incremental": "node ./scripts/run-incremental-mutation.mjs",
    "verify": "npm audit --audit-level=high --omit=dev && npm run lint && npm run test:cov && npm run test:fuzz && npm run build",
    "verify:full": "npm run verify && npm run lighthouse && npm run test:mutation:incremental",
    "e2e": "ng e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@auth0/angular-jwt": "^5.1.2",
    "@eslint/config-array": "^0.23.2",
    "@eslint/object-schema": "^3.0.1",
    "@sentry/angular": "^10.40.0",
    "glob": "^13.0.6",
    "http-proxy-middleware": "^3.0.5",
    "js-base64": "^3.7.7",
    "logrocket": "^12.0.0",
    "lru-cache": "^11.2.6",
    "moment": "^2.29.4",
    "ngx-image-cropper": "^9.1.6",
    "ngx-pagination": "^6.0.3",
    "ngx-toastr": "^20.0.5",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular-eslint/eslint-plugin": "^21.2.0",
    "@angular-eslint/eslint-plugin-template": "^21.2.0",
    "@angular-eslint/template-parser": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/jest-runner": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^4.5.3",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^16.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "serve": "^14.2.4",
    "typescript": "~5.9.3"
  },
  "projects": {
    "sto-info-frontend": {
      "architect": {
        "build": {
          "options": {
            "outputPath": "dist/sto-info-frontend"
          },
          "configurations": {
            "production": {
              "outputPath": "dist/sto-info-frontend"
            },
            "development": {
              "outputPath": "dist/sto-info-frontend"
            }
          }
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest-junit": {
    "suiteName": "sto-info-frontend",
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "usePathForSuiteName": "true"
  },
  "overrides": {
    "eslint": "^9.22.0",
    "ajv@^8.0.0": "8.18.0",
    "minimatch@<3.1.3": "3.1.3",
    "@stryker-mutator/core": {
      "minimatch": "10.2.2"
    },
    "tmp": "0.2.5"
  }
}
