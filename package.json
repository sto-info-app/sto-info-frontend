{
  "name": "sto-info-frontend",
  "version": "1.0.216",
  "description": "Star Trek Online Information App",
  "author": "Steve Roberts",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/steverobertsuk/sto-info-frontend.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-env": "node src/environments/inject-env-vars.js",
    "generate-version": "node scripts/generate-version.mjs",
    "generate-content": "node scripts/generate-content.mjs",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "build:render": "npm run generate-env && npm run generate-version && npm run generate-content && npm run build:prod",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint \"src/**/*.{ts,js,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js,html}\" --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint:lighthouse": "cross-env ENV_NAME=lighthouse-audit API_URL=https://dev-api.startrekonline.info npm run build:render && lhci autorun",
    "lighthouse": "cross-env API_URL=https://dev-api.startrekonline.info npm run build:prod && lhci collect && lhci upload --target=filesystem --outputDir=reports/lighthouse && npm run summary:ci",
    "summary:ci": "node scripts/generate-ci-summary.mjs",
    "test": "jest --config jest.config.cjs",
    "test:fuzz": "cross-env FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-50} jest --config jest.config.cjs --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:fuzz:full": "cross-env FUZZ_NUM_RUNS=${FUZZ_NUM_RUNS:-1000} jest --config jest.config.cjs --testRegex='.*\\.fuzz\\.spec\\.ts$' --coverage=false",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --runInBand --coverage --coverageDirectory=reports/coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=text",
    "test:mutation": "stryker run --reporters clear-text --reporters html --reporters progress",
    "test:mutation:dry": "stryker run --reporters clear-text --reporters html --reporters progress --dryRunOnly",
    "test:mutation:incremental": "node ./scripts/run-incremental-mutation.mjs",
    "verify": "npm audit --audit-level=high --omit=dev && npm run lint && npm run lint:style && npm run test:cov && npm run test:fuzz && npm run build",
    "verify:full": "npm run verify && npm run lighthouse && npm run test:mutation:incremental",
    "e2e": "ng e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-browser-dynamic": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@auth0/angular-jwt": "^5.1.2",
    "@eslint/config-array": "^0.23.5",
    "@eslint/object-schema": "^3.0.1",
    "@sentry/angular": "^10.60.0",
    "glob": "^13.0.6",
    "http-proxy-middleware": "^4.1.1",
    "js-base64": "^3.7.7",
    "logrocket": "^12.1.1",
    "lru-cache": "^11.5.1",
    "moment": "^2.29.4",
    "ngx-image-cropper": "^9.1.6",
    "ngx-pagination": "^6.0.3",
    "ngx-toastr": "^20.0.5",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "angular-eslint": "^22.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.8.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "serve": "^14.2.6",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "wawoff2": "^2.0.1"
  },
  "projects": {
    "sto-info-frontend": {
      "architect": {
        "build": {
          "options": {
            "outputPath": "dist/sto-info-frontend"
          },
          "configurations": {
            "production": {
              "outputPath": "dist/sto-info-frontend"
            },
            "development": {
              "outputPath": "dist/sto-info-frontend"
            }
          }
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest-junit": {
    "suiteName": "sto-info-frontend",
    "outputDirectory": "reports/junit",
    "outputName": "junit.xml",
    "addFileAttribute": "true",
    "usePathForSuiteName": "true"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "basic-ftp": "5.3.1",
    "qs": "6.15.2",
    "tmp": "0.2.7",
    "undici": "7.28.0",
    "uuid": "14.0.0",
    "ws": "8.21.0",
    "js-yaml": "4.2.0",
    "piscina": "5.2.0",
    "esbuild": "0.28.1",
    "picomatch": "4.0.4",
    "brace-expansion": "5.0.6",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "router": {
      "path-to-regexp": "8.4.2"
    }
  }
}
