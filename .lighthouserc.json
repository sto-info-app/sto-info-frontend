{
  "ci": {
    "collect": {
      "startServerCommand": "serve -s dist/sto-info-frontend/browser -p 4201",
      "url": [
        "http://localhost:4201/",
        "http://localhost:4201/login",
        "http://localhost:4201/register",
        "http://localhost:4201/about",
        "http://localhost:4201/about/team/developers",
        "http://localhost:4201/about/team/volunteers",
        "http://localhost:4201/about/team/supporters",
        "http://localhost:4201/contact",
        "http://localhost:4201/credits",
        "http://localhost:4201/privacy-policy",
        "http://localhost:4201/terms-of-use"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless --disable-gpu",
        "extraHeaders": { "Accept-Language": "en-US" },
        "reportExportFormat": "html"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "offscreen-images": "off",
        "uses-webp-images": "off",
        "color-contrast": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "filesystem": {
        "outputDir": "reports/lighthouse"
      }
    }
  }
}
