{
  "server": {
    "directory": "dist/sto-info-frontend/browser",
    "port": 4201
  },
  "urls": [
    "/",
    "/about",
    "/about/team/developers",
    "/about/team/volunteers",
    "/about/team/supporters",
    "/contact",
    "/resources",
    "/roadmap",
    "/credits",
    "/privacy-policy",
    "/terms-of-use"
  ],
  "runs": 3,
  "categories": ["performance", "accessibility", "best-practices", "seo"],
  "chromeFlags": ["--headless", "--no-sandbox", "--disable-gpu"],
  "extraHeaders": { "Accept-Language": "en-US" },
  "outputDir": "reports/lighthouse",
  "defaultMinScore": 0.9,
  "assertions": {
    "categories:performance": ["error", { "minScore": 0.8 }],
    "categories:accessibility": ["error", { "minScore": 0.9 }],
    "categories:best-practices": ["error", { "minScore": 0.9 }],
    "categories:seo": ["error", { "minScore": 0.9 }],
    "image-delivery-insight": "off",
    "color-contrast": "warn",
    "errors-in-console": "warn",
    "unused-css-rules": "warn",
    "unused-javascript": "warn",
    "network-dependency-tree-insight": "off",
    "legacy-javascript-insight": "warn",
    "max-potential-fid": "warn",
    "dom-size-insight": "warn",
    "largest-contentful-paint": ["warn", { "maxNumericValue": 6500 }],
    "lcp-discovery-insight": "off",
    "non-composited-animations": "off",
    "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.25 }],
    "valid-source-maps": "off",
    "is-crawlable": "off",
    "cache-insight": "off"
  }
}
