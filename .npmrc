@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/

# INSTRUCTIONS: To install private Font Awesome dependencies, do NOT modify this file.
# Instead, add your auth token to your user-level .npmrc file:
# 1. Open (or create) ~/.npmrc (Linux/macOS) or %USERPROFILE%\.npmrc (Windows)
# 2. Add the following line: //npm.fontawesome.com/:_authToken=YOUR_TOKEN_HERE
#
# Alternatively, set an environment variable named FONTAWESOME_NPM_AUTH_TOKEN.
# //npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_AUTH_TOKEN}

