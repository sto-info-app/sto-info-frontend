# Copy to e2e/.env.local (which git ignores) and fill in the values for this
# machine. Every E2E_* variable e2e/README.md lists may be set here; one a
# line, no quotes needed. A variable set in the shell wins over this file.

# The seed password: DATASEED_USER_PASSWORD from the backend's environment
# file. Needed by every project that signs in as the seed or demo members;
# the Fleet projects make their own people and do not read it.
E2E_PASSWORD=

# The database and Redis logical database the local backend is connected to.
# The harness refuses to run against anything else.
E2E_DATABASE_NAME=sto_info_app_local
E2E_REDIS_DB=0

# The backend checkout the support commands run in.
E2E_BACKEND_DIR=../sto-info-backend
